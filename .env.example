# The app and API run with deterministic demo adapters when these are absent.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_MAPBOX_TOKEN=
DATABASE_URL=
XAI_API_KEY=
XAI_TEXT_MODEL=grok-4.20-reasoning-latest
XAI_IMAGE_MODEL=grok-imagine-image-2.0
XAI_VOICE_ID=eve

# Location feature.
# Provider: EXPO (default) uses real device GPS and falls back to the
# deterministic simulator when no native location module is present.
# Set SIMULATED to force the scripted walk — useful for demoing indoors, on an
# emulator, or without a device.
EXPO_PUBLIC_LOCATION_PROVIDER=
# Which scripted route the simulator walks. See demoRoutes in
# @sidequest/location: route-craig-street-bakery (arrives at a GPS quest),
# route-schenley-loop, route-poor-signal (weak-signal failure state).
EXPO_PUBLIC_LOCATION_ROUTE=
