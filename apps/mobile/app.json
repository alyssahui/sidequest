{
  "expo": {
    "name": "SideQuest",
    "slug": "sidequest",
    "scheme": "sidequest",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sidequest.game"
    },
    "android": {
      "package": "com.sidequest.game"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}
