{
  "name": "sidequest",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "corepack pnpm --filter @sidequest/mobile start",
    "dev:api": "corepack pnpm --filter @sidequest/api dev",
    "build:web": "corepack pnpm --filter @sidequest/mobile build:web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "vitest run",
    "check": "corepack pnpm format:check && corepack pnpm typecheck && corepack pnpm test"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
